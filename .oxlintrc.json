{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "typescript", "react", "oxc", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    /* This is a fine rule, but only if it's auto-fixable (which it isn't right now) */
    "sort-imports": "off",
    /* React 17+ automatic JSX runtime — React does not need to be in scope */
    "react/react-in-jsx-scope": "off",
    /* Default max of 2 is too restrictive for typical component trees */
    "react/jsx-max-depth": ["error", { "max": 5 }],
    /* Small ids are fine. Correct usage is too context-dependent for a lint
    rule*/
    "id-length": "off",
    /* I don't find `() => voidFun()` confusing. */
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    /* Too pedantic most of the time */
    "typescript/prefer-readonly-parameter-types": "off",
    /* We have noImplicitReturns so don't need this */
    "typescript/consistent-return": "off",
    /* Ternaries are fine - excessive nesting is not */
    "no-ternary": "off",
    /* Import: each module should have a single export declaration so it's
    immediately obvious what is in the public api */
    "import/no-named-export": "off",
    "import/no-default-export": "error",
    "import/group-exports": "error",
    "import/prefer-default-export": "off",
    /* Too dogmatic. A responsibility does not have to be contained with a
    single class */
    "max-classes-per-file": "off",
    "max-params": ["error", { "max": 4 }],
    /* We're using node */
    "import/no-nodejs-modules": "off",
    /* Various rules conflict  */
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    /* magic numbers aren't great, but the blanket rule has too many false
    positives (e.g. 0 in a loop or 2 as a divisor) and I don't want to configure
    it */
    "no-magic-numbers": "off",
    /* Early returns are preferred */
    "no-else-return": ["error", { "allowElseIf": false }],
    /* STRICTNESS: the following should be enabled for strict linting, but not during normal development*/
    "import/max-dependencies": "off",
    "max-statements": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    /* 20 is quite high, so this is overriden in the strict rules */
    "complexity": ["error", { "max": 20 }]
    /* Project uses vitest globals: true — vi is always a global, no need to import */
  },

  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "test-setup.ts"],
      "rules": {
        "vitest/prefer-describe-function-title": "error",
        /* We use globals */
        "vitest/prefer-importing-vitest-globals": "off",
        /* expect-expect should be enough */
        "vitest/prefer-expect-assertions": "off",
        /* Tests often insert mocks where a void callback is expected, this is fine */
        "typescript/strict-void-return": "off",
        /* valid-title seems overly strict and rejects perfectly valid titles (e.g. describe(myFunction)) */
        "vitest/valid-title": "off",
        "jest/valid-title": "off",
        /* This doesn't apply to vitest and the vitest version does not work */
        "jest/valid-expect": "off",
        /* Starting a comment with a capital letter is generally nicer, but there are common exceptions (e.g. function names: // mkdir needs to be...) */
        "eslint/capitalized-comments": "off",

        /* Before/after hooks have their place*/
        "no-hooks": "off",
        "vitest/no-hooks": "off",
        /* A fairly common pattern is to declare a variable in describe block and
    initialize it in a hook. We want to allow this. */
        "init-declarations": "off",
        /* Strictness is preferrable for true or false */
        "vitest/prefer-to-be-falsy": "off",
        "vitest/prefer-to-be-truthy": "off",
        /* Either calledOnce or calledTimes(1) is fine, but we should pick one for consistency */
        "vitest/prefer-called-times": "off",
        /* We're more interested in testing behaviour. If a test needs to make an unsafe assertion, that's okay */
        "typescript/no-unsafe-type-assertion": "off",
        /* Nullable booleans get a pass so that optional flags (e.g. opts.isWhatever) can be used in ternaries */
        "typescript/strict-boolean-expressions": [
          "error",
          { "allowNullableBoolean": true, "allowNullableString": true }
        ],
        /* Generally this is a little neater, but there are lot of false positives.
    Consider simply disabling if the allowedPrefixes balloons */
        "jest/prefer-lowercase-title": [
          "error",
          {
            "allowedPrefixes": [
              /* HTTP methods */
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS",
              "TRACE",
              "CONNECT",
              /* Standard acronyms */
              "URL"
            ]
          }
        ]
      }
    }
  ]
}
